# Optional local configuration: copy to .env and customize. Never commit .env.
# Python runtime paths also have defaults in chipiron.utils.path_variables.
# Keep experiment/model output outside the repository (CHIPIRON_OUTPUT_DIR).
EXTERNAL_DATA_DIR=external_data
LICHESS_PGN_DIR=external_data/lichess_pgn
SYZYGY_TABLES_DIR=external_data/syzygy-tables
STOCKFISH_DIR=external_data/stockfish
GUI_DIR=external_data/gui
LICHESS_PGN_FILE=external_data/lichess_pgn/lichess_db_standard_rated_2015-03.pgn
STOCKFISH_BINARY_PATH=external_data/stockfish/stockfish/stockfish-ubuntu-x86-64-avx2
STOCKFISH_VERSION=16
SYZYGY_SOURCE=https://syzygy-tables.info/download.txt?source=sesse&max-pieces=5
STOCKFISH_URL=https://github.com/official-stockfish/Stockfish/releases/download/sf_16/stockfish-ubuntu-x86-64-avx2.tar
DATA_SOURCE=https://drive.google.com/drive/folders/1tvkuiaN-oXC7UAjUw-6cIl1PB0r2as7Y?usp=sharing
# Optional overrides; when absent the runtime uses its external user-data directory.
# CHIPIRON_OUTPUT_DIR=/absolute/path/outside/checkout/chipiron-runs
# ML_FLOW_URI_PATH=sqlite:////absolute/path/outside/checkout/mlruns.db
# ML_FLOW_URI_PATH_TEST=sqlite:////absolute/path/outside/checkout/mlruns_test.db
